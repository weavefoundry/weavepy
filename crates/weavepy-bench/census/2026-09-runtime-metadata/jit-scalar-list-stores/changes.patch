+#[test]
+fn typed_list_still_rejects_mismatched_scalar_stores() {
+    for (seed, value) in [("1", "0.5"), ("1", "True"), ("1.5", "1")] {
+        let source = format!("def k(n):\n    out = [{seed}]\n    for i in range(n):\n        out[0] = {value}\n    return out\n");
+        assert!(matches!(
+            analyze_cfg(&source, &Cfg::default()),
+            Err(JitVerdict::UnsupportedOpcode("STORE_SUBSCR (value lane)"))
+        ));
+    }
+}
