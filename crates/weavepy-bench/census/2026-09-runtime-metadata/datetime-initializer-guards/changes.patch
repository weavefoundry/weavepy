+assert not hasattr(value, '_year') and events == []
+assert init_date_fields(blank(), 4, 5, 6)
+value = blank()
+assert init_date_fields(value, 1, 2, 3)
+assert not init_date_fields(value, 4, 5, 6)
+assert (value._year, value._month, value._day) == (1, 2, 3)
+print('datetime inherited layout invalidation ok')
+"#),
+            "datetime inherited layout invalidation ok\n"
+        );
+    }
