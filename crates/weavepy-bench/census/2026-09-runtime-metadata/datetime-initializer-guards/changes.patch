+for i in range(3):
+    value = blank()
+    assert not init_date_fields(value, 1, 2, 3)
+    assert not hasattr(value, '_year')
+assert events == []
+Fields._month = old
+assert init_date_fields(blank(), 4, 5, 6)
+def setter(self, name, value):
+    events.append(name)
+Fields.__setattr__ = setter
+value = blank()
+assert not init_date_fields(value, 1, 2, 3)
+assert not hasattr(value, '_year') and events == []
+del Fields.__setattr__
+assert init_date_fields(blank(), 1, 2, 3)
+class OtherFields:
+    __slots__ = ('_year', '_month', '_day', '_hashcode')
+class Unrelated(OtherFields):
+    __slots__ = ()
