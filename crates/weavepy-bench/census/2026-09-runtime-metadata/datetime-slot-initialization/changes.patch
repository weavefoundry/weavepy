+fn add_field_initializer<const N: usize>(
+    dict: &mut DictData,
+    name: &'static str,
+    fields: [&str; N],
+    sources: [usize; N],
+    argument_count: usize,
+    counter: usize,
+) {
+    let names = fields.map(crate::shared_value::SharedStr::from);
+    let function = Object::Builtin(Rc::new(BuiltinFn {
+        name,
+        binds_instance: false,
+        call: Box::new(move |args| {
+            initialize_empty_fields(args, &names, &sources, argument_count, counter)
+        }),
+        call_kw: None,
+    }));
+    crate::descr_registry::register_module(&function, "_weave_datetime");
+    dict.insert(DictKey(Object::from_static(name)), function);
+}
+
+/// The original Python allocator and validation have already run. Decline
+/// before mutation for custom setters, descriptors, native bodies, or any
+/// populated slot. Ordinary writable slots can be built directly in their final representation
+/// without displacing a value or invoking Python.
+fn initialize_empty_fields<const N: usize>(
+    args: &[Object],
+    names: &[crate::shared_value::SharedStr; N],
+    sources: &[usize; N],
+    argument_count: usize,
+    _counter: usize,
+) -> Result<Object, RuntimeError> {
+    if args.len() != argument_count {
+        return Ok(Object::Bool(false));
+    }
+    let Some(Object::Instance(instance)) = args.first() else {
+        return Ok(Object::Bool(false));
+    };
+    if instance.native.get().is_some() || instance.c_body.get() != 0 {
+        return Ok(Object::Bool(false));
+    }
+    let class = instance.cls();
+    if class.flags.is_builtin
+        || !Rc::ptr_eq(
+            &class.metaclass_or_type(),
+            &crate::builtin_types::builtin_types().type_,
+        )
+        || !class.setattr_is_default()
+    {
+        return Ok(Object::Bool(false));
+    }
+    for name in names {
+        match class.lookup(name) {
+            Some(Object::SlotDescriptor(slot)) if !slot.readonly && slot.name == name.as_ref() => {}
+            _ => return Ok(Object::Bool(false)),
+        }
+    }
+    let mut slots = instance.slots.borrow_mut();
+    if slots.iter().next().is_some() {
+        return Ok(Object::Bool(false));
+    }
+    let hashcode = Object::Int(-1);
+    let fields: [(&crate::shared_value::SharedStr, &Object); N] = std::array::from_fn(|index| {
+        let source = sources[index];
+        (
+            &names[index],
+            if source == 0 {
+                &hashcode
+            } else {
+                &args[source]
+            },
+        )
+    });
+    *slots = crate::types::SlotStorage::from_shared_fields(&fields);
+    #[cfg(test)]
+    FIELD_INITIALIZATIONS_FOR_TEST.with(|counts| counts.borrow_mut()[_counter] += 1);
+    Ok(Object::Bool(true))
 }
 
