     #[cfg(feature = "jit")]
+    #[test]
+    fn jit_scalar_list_reads_preserve_values_and_pin_pressure() {
+        for (value, expected, initial_expected) in [
+            ("i * 3", "[59988, 59991, 59994, 59997]", "[0, 3, 6, 9]"),
+            (
+                "i + 0.5",
+                "[19996.5, 19997.5, 19998.5, 19999.5]",
+                "[0.5, 1.5, 2.5, 3.5]",
+            ),
+            (
+                "(i & 1) == 0",
+                "[True, False, True, False]",
+                "[True, False, True, False]",
+            ),
+        ] {
+            for iteration in [false, true] {
+                let source = if iteration {
+                    format!("def read(n):\n    items = [None] * 4\n    for i in range(4):\n        items[i] = {value}\n    result = [None] * 4\n    for outer in range(n):\n        k = 0\n        for value in items:\n            result[k] = value\n            k = k + 1\n    return result\nprint(read(5000))\n")
+                } else {
+                    format!("def read(n):\n    items = [None] * 4\n    result = [None] * 4\n    for i in range(n):\n        items[i & 3] = {value}\n        result[i & 3] = items[(i & 3) - 4]\n    return result\nprint(read(20000))\n")
+                };
+                let native_source = source.clone();
+                let (output, reads, pressure) = std::thread::spawn(move || {
+                    crate::tier2::force_enable_for_test(2);
+                    let output = run(&native_source);
+                    (
+                        output,
+                        crate::tier2::scalar_list_read_calls_for_test(),
+                        crate::tier2::pin_pressure_exits_for_test(),
+                    )
+                })
+                .join()
+                .expect("scalar list read worker");
+                let count = if iteration { reads.1 } else { reads.0 };
+                eprintln!("scalar native reads: {value}, iteration={iteration}, count={count}, pressure={pressure}");
+                assert_eq!(
+                    output,
+                    format!(
+                        "{}\n",
+                        if iteration {
+                            initial_expected
+                        } else {
+                            expected
+                        }
+                    )
+                );
+                assert!(count >= 18000, "scalar list reads did not stay native: count={count}, iteration={iteration}, {value}");
+                assert!(pressure > 0, "no temporary-pin pressure was exercised");
+                assert_eq!(output, run(&source));
+            }
+        }
+    }
