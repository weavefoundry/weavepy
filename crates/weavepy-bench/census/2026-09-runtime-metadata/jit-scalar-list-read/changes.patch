+    #[cfg(feature = "jit")]
+    #[test]
+    fn jit_scalar_list_reads_mutation() {
+        let source = r#"events = []
+marker = object()
+huge = 1 << 80
+def change(items):
+    events.append('change')
+    items[91:] = [False, 0.5, huge, None, marker]
+def collect(n):
+    items = [None] * n
+    result = []
+    index = 0
+    for i in range(n):
+        items[i] = i
+    for value in items:
+        result.append(value)
+        if index == 90:
+            change(items)
+        index = index + 1
+    return result
+result = collect(128)
+assert result == list(range(91)) + [False, 0.5, huge, None, marker]
+assert type(result[91]) is bool
+assert type(result[92]) is float
+assert type(result[93]) is int
+assert result[-1] is marker
+assert events == ['change']
+print('scalar list mutation and unsupported value ok')
+"#;
+        let (output, reads) = std::thread::spawn(move || {
+            crate::tier2::force_enable_for_test(2);
+            let output = run(source);
+            (output, crate::tier2::scalar_list_read_calls_for_test())
+        })
+        .join()
+        .expect("scalar list read semantics worker");
+        let count = reads.1;
+        eprintln!("scalar native reads before mutation fallback: count={count}");
+        assert_eq!(output, "scalar list mutation and unsupported value ok\n");
+        assert!(
+            count >= 90,
+            "scalar list read native prefix missing: {count}"
+        );
+        assert_eq!(output, run(source));
+    }
