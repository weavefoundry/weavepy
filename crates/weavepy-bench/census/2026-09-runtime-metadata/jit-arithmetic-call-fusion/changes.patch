+#[test]
+fn observed_integer_arithmetic_fuses_last_dynamic_result() {
+    use weavepy_compiler::{InlineCache, OpCode};
+
+    let code = compile_first_fn(
+        "def k(n, first, second):\n    total = 0\n    for i in range(n):\n        total += first(i) + second(i)\n    return total\n",
+    );
+    for (pc, ins) in code.instructions.iter().enumerate() {
+        if ins.op == OpCode::BinaryOp {
+            code.caches
+                .set(u32::try_from(pc).unwrap(), InlineCache::BinOpAddInt);
+        }
+    }
+    let tf = analyze_code_cfg(
+        &code,
+        &Cfg {
+            obj_params: vec![1, 2],
+            ..Cfg::default()
+        },
+    )
+    .expect("observed opaque arithmetic should analyze");
+    let results: Vec<_> = tf
+        .blocks
+        .iter()
+        .flat_map(|block| &block.stmts)
+        .filter_map(|stmt| {
+            if let TOp::CallDyn { int_result, .. } = stmt.op {
+                Some(int_result)
+            } else {
+                None
+            }
+        })
+        .collect();
+    assert_eq!(
+        results,
+        [false, true],
+        "the last dynamic result must use the integer lane"
+    );
+    let guards: Vec<_> = tf
+        .blocks
+        .iter()
+        .flat_map(|block| &block.stmts)
+        .filter_map(|stmt| {
+            if let TOp::UnboxInt { depth } = stmt.op {
+                Some(depth)
+            } else {
+                None
+            }
+        })
+        .collect();
+    assert_eq!(
+        guards,
+        [1],
+        "only the earlier result needs a separate guard"
+    );
 }
 
