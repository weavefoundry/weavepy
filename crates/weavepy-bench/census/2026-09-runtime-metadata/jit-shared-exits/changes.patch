     fn emit_exit(&mut self, pc: u32, snapshot: &[(Value, JitType)], status: JitStatus) {
+        let block = if let Some(exit) = self.exits.iter().find(|exit| {
+            exit.status == status
+                && exit.stack_types.len() == snapshot.len()
+                && exit
+                    .stack_types
+                    .iter()
+                    .zip(snapshot)
+                    .all(|(expected, (_, actual))| expected == actual)
+        }) {
+            exit.block
+        } else {
+            let block = self.b.create_block();
+            self.b.append_block_param(block, types::I32);
+            for &(_, ty) in snapshot {
+                self.b.append_block_param(block, Self::cl_ty(ty));
+            }
+            self.exits.push(SharedExit {
