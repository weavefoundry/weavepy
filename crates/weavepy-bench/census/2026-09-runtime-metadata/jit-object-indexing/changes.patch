+/// Read through the interpreter's full subscription protocol. Only an exact
+/// machine integer continues natively; every other completed result is parked.
+///
+/// # Safety
+///
+/// Same live-frame, context, and pin ownership contract as [`wpjit_call_py`].
+/// The receiver is an object-lane pin and `index` is a signed integer value.
+unsafe extern "C" fn wpjit_obj_getitem_int(frame: *mut JitFrame, pin: i64, index: i64) -> i64 {
+    #[cfg(test)]
+    OBJECT_INDEX_TEST_CALLS.with(|count| count.set(count.get() + 1));
+    // SAFETY: generated code supplies the live activation and its context.
+    let jf = unsafe { &mut *frame };
+    #[allow(clippy::cast_ptr_alignment)]
+    let ctx = unsafe { &mut *jf.ctx.cast::<CallCtx>() };
+    // SAFETY: the entering interpreter borrow is dormant during the helper.
+    let interp = unsafe { &mut *ctx.interp };
+    let receiver = if pin == -1 {
+        Object::None
+    } else {
+        match ctx.pins.get(pin as usize) {
+            Some(value) => value.to_object(),
+            None => return 3,
+        }
+    };
+    ctx.dirty = true;
+    let result = call_with_activation_shell(interp, ctx, jf, |interp| {
+        interp.subscr_get_public(&receiver, &Object::Int(index))
+    });
+    match result {
+        Err(error) => {
+            ctx.raised = Some(error);
+            1
+        }
+        Ok(value) => {
+            let still_valid = guards_hold(
+                interp,
+                &ctx.globals,
+                &ctx.builtins,
+                &ctx.guard_snapshot,
+                &ctx.callees,
+                &ctx.math,
+            );
+            if still_valid {
+                if let Object::Int(integer) = &value {
+                    jf.ret_bits = *integer as u64;
+                    return 0;
+                }
+            }
+            // The lookup already ran, including any callbacks. Reconstruction
+            // pushes this exact object and resumes after BINARY_SUBSCR.
+            ctx.parked = Some(value);
+            2
+        }
+    }
+}
