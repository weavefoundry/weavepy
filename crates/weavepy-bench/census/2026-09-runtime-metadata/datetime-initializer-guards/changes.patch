+    fn datetime_initializer_mutation() {
+        assert_eq!(
+            run(r#"from _weave_datetime import init_date_fields
+events = []
+class Fields:
+    __slots__ = ('_year', '_month', '_day', '_hashcode')
+class Child(Fields):
+    __slots__ = ()
+def blank():
+    return object.__new__(Child)
+for i in range(100):
+    assert init_date_fields(blank(), i, 2, 3)
+old = Fields._month
