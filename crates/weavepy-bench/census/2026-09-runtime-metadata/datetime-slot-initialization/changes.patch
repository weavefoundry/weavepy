 impl SlotStorage {
+    /// Build fresh slot storage with unique shared names in insertion order.
+    /// Callers must not use this to replace populated storage.
+    pub(crate) fn from_shared_fields(
+        fields: &[(&crate::shared_value::SharedStr, &Object)],
+    ) -> Self {
+        debug_assert!(fields
+            .iter()
+            .enumerate()
+            .all(|(index, (name, _))| { fields[..index].iter().all(|(prior, _)| prior != name) }));
+        match fields {
+            [] => Self::default(),
+            [(name, value)] => Self {
+                data: SlotData::Single {
+                    key: Some(DictKey(Object::Str((*name).clone()))),
+                    value: (*value).clone(),
+                },
+            },
+            fields if fields.len() <= 8 => Self {
+                data: SlotData::Small(
+                    fields
+                        .iter()
+                        .map(|(name, value)| {
+                            (DictKey(Object::Str((*name).clone())), (*value).clone())
+                        })
+                        .collect(),
+                ),
+            },
+            fields => {
+                let mut table = DictData::with_capacity_and_hasher(
+                    fields.len(),
+                    crate::fasthash::FxBuildHasher,
+                );
+                for (name, value) in fields {
+                    table.insert(DictKey(Object::Str((*name).clone())), (*value).clone());
+                }
+                Self {
+                    data: SlotData::Many(table),
+                }
+            }
+        }
+    }
