 #[test]
+fn generic_list_accepts_native_scalar_stores() {
+    for value in ["i * i", "i + 0.5", "i < 2"] {
+        let source = format!(
+            "def k(n):\n    out = [None] * 4\n    for i in range(n):\n        out[i & 3] = {value}\n    return out\n"
+        );
+        let tf = analyze_cfg(&source, &Cfg::default()).expect("scalar store should compile");
+        assert!(has_op(&tf, |op| matches!(op, TOp::ListSet)));
+        assert!(tf.local_types.contains(&Some(JitType::ListObj)));
+    }
+}
