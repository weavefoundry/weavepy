+    #[test]
+    fn datetime_slot_initialization_storage_order_and_aliases() {
+        use crate::shared_value::SharedStr;
+        use crate::types::SlotStorage;
+        for count in [0, 1, 2, 4, 7, 8, 9, 10, 16] {
+            let names: Vec<SharedStr> = (0..count)
+                .map(|i| SharedStr::from(format!("field_{i}")))
+                .collect();
+            let marker = Object::new_list(vec![Object::Int(73)]);
+            let values: Vec<Object> = (0..count)
+                .map(|i| {
+                    if i + 1 == count {
+                        marker.clone()
+                    } else {
+                        Object::Int(i as i64)
+                    }
+                })
+                .collect();
+            let fields: Vec<_> = names.iter().zip(values.iter()).collect();
+            let mut direct = SlotStorage::from_shared_fields(&fields);
+            let mut incremental = SlotStorage::default();
+            for (name, value) in &fields {
+                incremental.insert_shared(name, (*value).clone());
+            }
+            let keys = |slots: &SlotStorage| {
+                slots
+                    .iter()
+                    .map(|(key, _)| match &key.0 {
+                        Object::Str(name) => name.to_string(),
+                        _ => panic!("slot key"),
+                    })
+                    .collect::<Vec<_>>()
+            };
+            assert_eq!(keys(&direct), keys(&incremental));
+            for (i, name) in names.iter().enumerate() {
+                if i + 1 == count {
+                    let Object::List(actual) = direct.get(name).expect("present slot") else {
+                        panic!("lost container type")
+                    };
+                    let Object::List(expected) = &marker else {
+                        unreachable!()
+                    };
+                    assert!(Rc::ptr_eq(actual, expected), "lost alias");
+                } else {
+                    assert_eq!(direct.get(name).and_then(Object::as_i64), Some(i as i64));
+                }
+            }
+            if count > 0 {
+                direct.remove(&names[count / 2]);
+                incremental.remove(&names[count / 2]);
+                direct.insert_shared(&names[0], Object::Int(-1));
+                incremental.insert_shared(&names[0], Object::Int(-1));
+                assert_eq!(keys(&direct), keys(&incremental));
+                assert_eq!(direct.get(&names[0]).and_then(Object::as_i64), Some(-1));
+            }
+        }
+    }
