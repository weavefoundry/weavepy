+#[test]
+fn observed_opaque_integer_arithmetic_guards_both_operands() {
+    use weavepy_compiler::{InlineCache, OpCode, BINARY_OP_INPLACE_FLAG};
+
+    for (operator, cache, result) in [
+        ("+", InlineCache::BinOpAddInt, JitType::Int),
+        ("-", InlineCache::BinOpSubInt, JitType::Int),
+        ("*", InlineCache::BinOpMulInt, JitType::Int),
+        ("/", InlineCache::BinOpDivInt, JitType::Float),
+        ("//", InlineCache::BinOpFloorDivInt, JitType::Int),
+        ("%", InlineCache::BinOpModInt, JitType::Int),
+    ] {
+        for inplace in [false, true] {
+            let mut code = compile_first_fn(&format!("def k(a, b):\n    return a {operator} b\n"));
+            let pc = code
+                .instructions
+                .iter()
+                .position(|ins| ins.op == OpCode::BinaryOp)
+                .unwrap();
+            if inplace {
+                code.instructions[pc].arg |= BINARY_OP_INPLACE_FLAG;
+            }
+            let pc = u32::try_from(pc).unwrap();
+            code.caches.set(pc, cache);
+            let tf = analyze_code_cfg(
+                &code,
+                &Cfg {
+                    obj_params: vec![0, 1],
+                    ..Cfg::default()
+                },
+            )
+            .expect("observed opaque integer operands must analyze with guards");
+            let guards: Vec<_> = tf
+                .blocks
+                .iter()
+                .flat_map(|block| &block.stmts)
+                .filter_map(|stmt| {
+                    if let TOp::UnboxInt { depth } = stmt.op {
+                        Some((stmt.pc, depth))
+                    } else {
+                        None
+                    }
+                })
+                .collect();
+            assert_eq!(guards, [(pc, 1), (pc, 0)], "{operator}, inplace={inplace}");
+            assert_eq!(tf.ret_lane, Some(result));
+            assert_eq!(tf.local_types, [Some(JitType::Obj), Some(JitType::Obj)]);
+        }
+    }
+}
